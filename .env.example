# Names only — never commit real values.
# Client-visible (this app is TanStack Start / Vite; NEXT_PUBLIC_* is accepted as an alias).
NEXT_PUBLIC_CDP_CLIENT_API_KEY=
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_CHAIN=base

# Server-only — must be present at Vercel *runtime* (not just listed at build).
# After setting these, Redeploy. The ticket prints "0x key: loaded" when it can see the secret.
ZERO_EX_API_KEY=
ONEINCH_API_KEY=
BASE_RPC=
CRON_SECRET=

